---
// Assets
import { Image } from "astro:assets";
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
// Content
const { title, description, url, image } = {
  url: "/blog/posts/" + Astro.props.post.id,
  title: Astro.props.post.data.title,
  description: Astro.props.post.data.description,
  image: Astro.props.post.data.image.url,
};
---

<article
  class="relative group bg-white flex flex-col overflow-hidden p-8 gap-24 lg:gap-62 h-full justify-between"
>
  <a
    href={url}
    title={`Read more: ${title}`}
    aria-label={`Read blog post: ${title}`}
    class="absolute inset-0 z-10"></a>

  <div>
    <Text tag="h3" variant="displayMD" class="text-base-900 mt-8 font-display"
      >{title}</Text
    >
    <Text tag="p" variant="textBase" class="text-base-600 mt-4 text-pretty"
      >{description}</Text
    >
  </div>
  <Text
    tag="p"
    variant="textSM"
    class="uppercase font-medium text-base-900 group-hover:text-accent-400 mt-4"
    >Read further</Text
  >
</article>
