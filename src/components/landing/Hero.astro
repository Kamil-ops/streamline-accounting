---
// Assets
import { Image } from "astro:assets";
import HeroImage from "@/images/assets/heroImage.png";
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Kicker from "@/components/fundations/elements/Kicker.astro";

import Wrapper from "@/components/fundations/containers/Wrapper.astro";
---

<section>
  <Wrapper variant="standard" class="pt-24">
    <div class="max-w-2xl">
      <Kicker variant="default">Mulberry Accounting</Kicker>
      <Text
        tag="h1"
        variant="displayLG"
        class="text-base-900 text-balance font-medium tracking-tight mt-8 font-display"
      >
        Expert accounting services for businesses
      </Text>
      <Text tag="p" variant="textBase" class="text-base-600 lg:text-balance mt-4">
        Professional bookkeeping, tax planning, and financial advisory services
        tailored to help your business thrive. Trusted by entrepreneurs across
        all industries.
      </Text>
    </div>
  
  </Wrapper>
  <Wrapper variant="paddingLess" class="pt-12 overflow-hidden relative">
    <Image
      src={HeroImage}
      alt="Hero Image"
      width={1200}
      height={1400}
      loading="eager"
      decoding="async"
      class="w-full max-h-200 object-cover object-top"
    />
  </Wrapper>
</section>
