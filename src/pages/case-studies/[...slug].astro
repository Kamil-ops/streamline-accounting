---
import { getCollection, render } from "astro:content";
import CaseStudiesLayout from "@/layouts/CaseStudiesLayout.astro";

export async function getStaticPaths() {
  const caseStudies = await getCollection("caseStudies");
  const paths = caseStudies.map((page) => {
    return {
      params: { slug: page.id },
      props: { page },
      trailingSlash: false,
    };
  });
  return paths;
}

const { page } = Astro.props;
const { Content } = await render(page);
---

<CaseStudiesLayout frontmatter={page.data}>
  <Content />
</CaseStudiesLayout>
